PITWALL_FIXTURE_PATH=data/samples/demo_race.json
PITWALL_KNOWLEDGE_DB=data/cache/knowledge.db
PITWALL_KNOWLEDGE_PATH=knowledge/strategy-principles.md
PITWALL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PITWALL_API_URL=http://127.0.0.1:8000
# Optional. The deterministic replay and dashboard do not require this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Calendar, results and standings provider. Cached in process for five minutes.
PITWALL_JOLPICA_URL=https://api.jolpi.ca/ergast/f1
# Optional comma-separated RSS/Atom feed URLs; empty means news is unconfigured.
# Example verified feed: https://feeds.bbci.co.uk/sport/formula1/rss.xml
PITWALL_NEWS_FEEDS=
